# Optional local configuration. Store the AI key with scripts/configure-ai.py, not here.
API_AUDITOR_APP_NAME=API Change Impact Auditor
# Local SQLite history is stored under:
# %LOCALAPPDATA%\ApiChangeAuditor
# API_AUDITOR_RUNTIME_ROOT=C:\path\outside\source\ApiChangeAuditor
API_AUDITOR_HISTORY_MAX_RECORDS=100
API_AUDITOR_HISTORY_MAX_BYTES=67108864
API_AUDITOR_AI_ENABLED=true
API_AUDITOR_AI_DAILY_LIMIT=50
